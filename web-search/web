#!/usr/bin/env bash
# web — 统一入口：把"python3 scripts/<工具>.py"封装成"web <工具>"。
# 用法:  web <command> [args...]
#   web search --query "claude code"
#   web fetch --url https://example.com --format markdown
#   web search_read --query "..." --top 3
#   web                 # 不带参数 → 列出所有可用命令

set -euo pipefail

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPTS_DIR="$SELF/scripts"
if [ ! -d "$SCRIPTS_DIR" ]; then
  if [ -f "$SELF/_common.py" ]; then SCRIPTS_DIR="$SELF"; fi
fi

pick_python() {
  for cand in python3 python; do
    if command -v "$cand" >/dev/null 2>&1; then
      if "$cand" -c 'import sys; sys.exit(0 if sys.version_info[:2] >= (3,6) else 1)' >/dev/null 2>&1; then
        echo "$cand"; return 0
      fi
    fi
  done
  return 1
}
PY="$(pick_python || true)"
if [ -z "${PY:-}" ]; then
  echo "RESULT_JSON: {\"status\":\"error\",\"stage\":\"web\",\"error\":\"未找到 Python>=3.6（试过 python3/python）\"}"
  exit 0
fi

list_commands() {
  echo "web — 可用命令（用法: web <command> [args...]）"
  echo
  for f in "$SCRIPTS_DIR"/*.py; do
    base="$(basename "$f" .py)"
    case "$base" in
      _*) continue ;;
    esac
    echo "  web $base"
  done
  echo
  echo "查看某命令的参数：web <command> --help"
}

if [ $# -eq 0 ]; then
  list_commands
  exit 0
fi

CMD="$1"; shift
case "$CMD" in
  -h|--help|help|list)
    list_commands; exit 0 ;;
esac

TARGET="$SCRIPTS_DIR/$CMD.py"
if [ ! -f "$TARGET" ]; then
  echo "RESULT_JSON: {\"status\":\"error\",\"stage\":\"web\",\"error\":\"未知命令: $CMD\"}"
  list_commands >&2
  exit 0
fi

"$PY" "$TARGET" "$@"
rc=$?
if [ "$rc" -ne 0 ]; then
  echo "RESULT_JSON: {\"status\":\"error\",\"stage\":\"$CMD\",\"error\":\"命令异常退出（exit $rc），详见 stderr\"}"
fi
exit 0
